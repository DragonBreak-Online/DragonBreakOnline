<?xml version="1.0" encoding="UTF-8"?>
<!--
Base structure for the DBO decor panel. Ours, written by hand, not derived from any Bethesda or mod file.
Everything visible is created at runtime by scripts/frame_1/DoAction.as, so this holds no shapes, text or
fonts: one frame with an empty action tag for the compiler to import into. actionBytes="00" is a single
ActionEnd, which is the smallest valid script body.
Stage is 1280x720 in twips (x20). The custom menu is loaded with ScaleModeType::kNoBorder, so it scales.
-->
<swf _xmlExportMajor="2" _xmlExportMinor="2" type="SWF" charset="UTF-8" compression="NONE" encrypted="false" frameCount="1" frameRate="30.0" gfx="false" hasEndTag="true" version="15">
  <displayRect type="RECT" Xmax="25600" Xmin="0" Ymax="14400" Ymin="0" nbits="16"/>
  <tags>
    <item type="FileAttributesTag" actionScript3="false" forceWriteAsLong="false" hasMetadata="false" noCrossDomainCache="false" reservedA="false" reservedB="0" swfRelativeUrls="false" useDirectBlit="false" useGPU="false" useNetwork="false"/>
    <item type="DoActionTag" forceWriteAsLong="false" actionBytes="00"/>
    <item type="ShowFrameTag" forceWriteAsLong="false"/>
  </tags>
</swf>
